  "standing_gaps": [
    {
      "topic": "Diagrams / layout",
      "detail": "SysML v2 interchange carries semantics, not diagram layout. Views must be re-authored in the target tool (Cameo 2026x v2 plugin generates views from the model)."
    },
    {
      "topic": "Custom profile stereotypes",
      "detail": "Carried as `metadata def`s so every tagged element keeps its classification and tag values, but the tool-side behaviour (icons, validation rules, DSL customisations, derived properties, table definitions) is not expressible in v2 and has to be re-created."
    },
    {
      "topic": "Satisfy / Verify",
      "detail": "v2 `satisfy ... by` requires a part *usage*; v1 satisfies typically point at Blocks (definitions). Emitted as tagged dependencies until the satisfying usage is chosen."
    },
    {
      "topic": "Item flows between blocks",
      "detail": "v2 flows need a common part context; v1 InformationFlows drawn between features of unrelated blocks are kept as tagged dependencies."
    },
    {
      "topic": "Activity / state-machine internals",
      "detail": "Action and transition graphs are structurally different in v2 (succession-based). Signatures are migrated; bodies flagged for re-modelling."
    },
    {
      "topic": "Operations",
      "detail": "v2 has no operations; emitted as nested actions for review."
    },
    {
      "topic": "Units / quantity kinds",
      "detail": "MagicDraw ISO-80000 / SI library imports map to the v2 `ISQ` and `SI` libraries but need an explicit mapping table."
    },
    {
      "topic": "Instance specifications",
      "detail": "v2 has no instances; use individuals/snapshots or attribute defaults."
    },
    {
      "topic": "PackageMerge",
      "detail": "No v2 support (per the OMG transformation document)."
    }
  ],
